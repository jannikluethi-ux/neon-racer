{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VehicleDefinition",
  "type": "object",
  "required": ["id", "name", "description", "startsUnlocked", "color", "body", "paint", "physics", "audio", "aiProfile"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "startsUnlocked": { "type": "boolean" },
    "color": { "type": "integer" },
    "body": {
      "type": "object",
      "properties": {
        "type": { "const": "procedural" },
        "silhouette": { "type": "string" },
        "dimensions": {
          "type": "object",
          "properties": {
            "length": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" },
            "wheelbase": { "type": "number" }
          },
          "required": ["length", "width", "height", "wheelbase"]
        },
        "bodyScale": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "cabinScale": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "noseScale": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "wingScale": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
      },
      "required": ["type", "silhouette", "dimensions", "bodyScale", "cabinScale", "noseScale", "wingScale"]
    },
    "paint": {
      "type": "object",
      "properties": {
        "baseColor": { "type": "integer" },
        "accentColor": { "type": "integer" },
        "glassColor": { "type": "integer" },
        "metalness": { "type": "number" },
        "roughness": { "type": "number" },
        "clearcoat": { "type": "number" },
        "clearcoatRoughness": { "type": "number" },
        "flakeIntensity": { "type": "number" },
        "flakeScale": { "type": "number" }
      },
      "required": ["baseColor", "accentColor", "glassColor", "metalness", "roughness", "clearcoat", "clearcoatRoughness", "flakeIntensity", "flakeScale"]
    },
    "physics": {
      "type": "object",
      "additionalProperties": true
    },
    "audio": {
      "type": "object",
      "properties": {
        "pitch": { "type": "number" },
        "detune": { "type": "number" },
        "grit": { "type": "number" },
        "harm": { "type": "number" },
        "bark": { "type": "number" },
        "exhaust": { "type": "number" }
      },
      "required": ["pitch", "detune", "grit", "harm", "bark", "exhaust"]
    },
    "aiProfile": {
      "type": "object",
      "additionalProperties": true
    }
  }
}